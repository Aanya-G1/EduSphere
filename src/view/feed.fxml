<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.FeedController" style="-fx-background-color: #CAF0F8">	
	<center>
		<ScrollPane fitToWidth="true" maxWidth="600" style="-fx-background-color:transparent;">
			<VBox fx:id="feedContainer" style="-fx-background-color: #F2D965;-fx-padding: 20; -fx-min-height: 800;" spacing="10" alignment="CENTER" />
		</ScrollPane>
	</center>
	<top>
		<BorderPane style="-fx-background-color:#FFF9F0; -fx-padding: 8;">
			
			<left>
				<Button fx:id="backBtn" text="← Back" onAction="#handleBack"
						style="-fx-background-color: #FFF9E6; 
							   -fx-text-fill: #3c3c3c; 
							   -fx-font-family: 'Segoe UI'; 
							   -fx-font-weight: bold; 
							   -fx-font-size: 14px; 
							   -fx-background-radius: 20; 
							   -fx-padding: 6 14 6 14;" 
						BorderPane.alignment="CENTER"/>
			</left>
			
			<center>
				<HBox alignment="CENTER" spacing="10">
					<TextField fx:id="searchBar" promptText="search..."/>
					<Button fx:id="searchBtn" text="Search" onAction="#searchPosts"/>
				</HBox>
			</center>
			
			<right>
				<Region prefWidth="85" />
			</right>

		</BorderPane>
	</top>
	<left>
		<MenuBar>
			<Menu text="Posts">
				<MenuItem fx:id="addPost" text="Add Post" onAction="#openAddPost"/>
			</Menu>
		</MenuBar>
	</left>

</BorderPane>
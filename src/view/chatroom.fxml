<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ListView?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.ChatroomController" style="-fx-background-color: #CAF0F8">
	<top>
		<HBox alignment="CENTER_LEFT" style="-fx-padding: 10;">
			<Button fx:id="backBtn" text="← Back" onAction="#handleBack"
				style="-fx-background-color: #FFF9E6; 
					   -fx-text-fill: #3c3c3c; 
					   -fx-font-family: 'Segoe UI'; 
					   -fx-font-weight: bold; 
					   -fx-font-size: 14px; 
					   -fx-background-radius: 20; 
					   -fx-padding: 6 14 6 14;"/>
		</HBox>
	</top>
	<left>
		<VBox>
			<Label text="Chatrooms">
						<font>
							<Font name="System Bold" size="13.0" />
						</font>
			</Label>
			<Button fx:id="createBtn" text="Create Room" onAction="#createRoom"/>
			<ListView fx:id="roomlist"/>
		</VBox>
	</left>
	<center>
    	<VBox>
    		<Label fx:id="roomName"/>
        	<ScrollPane fx:id="chatScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
            	<VBox fx:id="messageContainer" spacing="10.0" style="-fx-padding: 10;" />
        	</ScrollPane>

        	<HBox alignment="CENTER" prefHeight="60.0" spacing="5.0" style="-fx-padding: 5;">
            	<TextField fx:id="userInputField" onAction="#handleSendMessage" promptText="Type a message..." HBox.hgrow="ALWAYS" />
            	<Button onAction="#handleSendMessage" text="Send" style="-fx-background-color: #0078FF; -fx-text-fill: white;" />
        	</HBox>
    	</VBox>
	</center>
</BorderPane>
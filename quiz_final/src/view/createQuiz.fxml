<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.CreateQuizController" style="-fx-background-color: #CAF0F8">
	<center>
		<VBox style="-fx-background-color:#FCF7DF; -fx-border-color:white; -fx-border-width:5;" maxWidth="600" minWidth="600" spacing="15">
			<Label text="Create New Quiz">
				<font>
					<Font name="System Bold" size="20.0" />
				</font>
			</Label>
			<VBox spacing="5">
				<Label text="Quiz Title">
					<font>
						<Font name="System Bold" size="14.0" />
					</font>
				</Label>
				<TextField fx:id="titleField" promptText="Enter quiz title"/>
			</VBox>
			<VBox spacing="5">
				<Label text="Subject">
					<font>
						<Font name="System Bold" size="14.0" />
					</font>
				</Label>
				<ChoiceBox fx:id="subjectChoice" style="-fx-background-color: white"/>
			</VBox>
			<Label text="Add Questions" style="-fx-border-color: #CAF0F8; -fx-border-width: 0 0 2 0;">
				<font>
					<Font name="System Bold" size="15.0" />
				</font>
			</Label>
			<TextField fx:id="qField" promptText="Enter question"/>
			<TextField fx:id="o1" promptText="Option 1"/>
			<TextField fx:id="o2" promptText="Option 2"/>
			<TextField fx:id="o3" promptText="Option 3"/>
			<TextField fx:id="o4" promptText="Option 4"/>
			<TextField fx:id="correctField" promptText="Correct Answer (1-4)"/>
			<Button fx:id="addQuestionBtn" text="Add Question" onAction="#addQuestion" style="-fx-background-color: #99C3E4; -fx-background-radius: 10; -fx-font-weight: bold;"/>
			<Label fx:id="questionCount" text="Questions Added: 0" style="-fx-text-fill: #555555;"/>
			<ListView fx:id="questionsList" prefHeight="100"/>
			<HBox alignment="CENTER">
				<Button fx:id="saveQuizBtn" text="Save Quiz" onAction="#saveQuiz" style="-fx-background-color: white; -fx-background-radius: 15;" prefWidth="150" prefHeight="50"/>
			</HBox>
		</VBox>
	</center>
</BorderPane>

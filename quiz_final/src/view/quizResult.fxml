<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="controller.QuizResultController" style="-fx-background-color: #CAF0F8">
	<center>
		<VBox style="-fx-background-color:#FCF7DF; -fx-border-color:white; -fx-border-width:5;" maxWidth="700" minWidth="700" spacing="20">
			<Label text="Quiz Result">
				<font>
					<Font name="System Bold" size="22.0" />
				</font>
			</Label>
			<Label fx:id="scoreLabel" text="Your Score: 0 / 0">
				<font>
					<Font name="System Bold" size="18.0" />
				</font>
			</Label>
			<Label fx:id="summaryLabel" text="" wrapText="true" style="-fx-text-fill: #555555;">
				<font>
					<Font size="14.0" />
				</font>
			</Label>
			<Label text="Answer Review">
				<font>
					<Font name="System Bold" size="15.0" />
				</font>
			</Label>
			<ScrollPane fitToWidth="true" prefHeight="400" style="-fx-background-color: transparent;">
				<VBox fx:id="reviewContainer" spacing="10"/>
			</ScrollPane>
		</VBox>
	</center>
</BorderPane>
